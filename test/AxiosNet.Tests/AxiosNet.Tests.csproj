<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与类库的 TFM 对齐：net6.0 那套用例验证「最低支持基线」的真实行为（含连接池、流式、JSON）。
         net8.0 之外的测试基建都只用 netstandard2.0 级别的 API，可直接复用。 -->
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <!-- net6.0 默认 C# 10，测试里用了原始字符串字面量（C# 11），统一用最新语言版本 -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AxiosNet\AxiosNet.csproj" />
    <!-- 生成器测试用 CSharpGeneratorDriver 直接驱动；普通引用（非 Analyzer），不会分析本测试项目源码。 -->
    <ProjectReference Include="..\..\src\AxiosNet.SourceGen\AxiosNet.SourceGen.csproj" />
  </ItemGroup>

</Project>
