<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与类库的 TFM 对齐：net6.0 那套用例验证「最低支持基线」的真实行为（含连接池、流式、JSON）。
         net8.0 之外的测试基建都只用 netstandard2.0 级别的 API，可直接复用。 -->
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <!-- net6.0 默认 C# 10，测试里用了原始字符串字面量（C# 11），统一用最新语言版本 -->
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Internal 内核按职责拆分命名空间，测试直接导入内部实现做细粒度验证。 -->
    <Using Include="AxiosNet.Internal.Content" />
    <Using Include="AxiosNet.Internal.Headers" />
    <Using Include="AxiosNet.Internal.Response" />
    <Using Include="AxiosNet.Internal.Serialization" />
    <Using Include="AxiosNet.Internal.Support" />
    <Using Include="AxiosNet.Internal.Url" />
    <!-- 声明式 API 的内部契约按职责拆分命名空间。 -->
    <Using Include="AxiosNet.WebAPI.Internal.Authorization" />
    <Using Include="AxiosNet.WebAPI.Internal.Binding" />
    <Using Include="AxiosNet.WebAPI.Internal.Metadata" />
    <Using Include="AxiosNet.WebAPI.Internal.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- 公共 API 基线随构建复制到输出目录：比对只读输出目录（不依赖源码树 / 不需要写权限），
         只有 AXIOSNET_REFRESH_API_BASELINE=1 时才写回源码树。 -->
    <None Update="PublicApi/PublicAPI.*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AxiosNet/AxiosNet.csproj" />
    <!-- 生成器测试用 CSharpGeneratorDriver 直接驱动；普通引用（非 Analyzer），不会分析本测试项目源码。 -->
    <ProjectReference Include="../../src/AxiosNet.SourceGen/AxiosNet.SourceGen.csproj" />
  </ItemGroup>

</Project>
