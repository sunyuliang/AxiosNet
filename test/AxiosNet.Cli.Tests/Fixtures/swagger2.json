{
  "swagger": "2.0",
  "info": { "title": "Legacy API", "version": "1.0" },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "securityDefinitions": {
    "basicAuth": { "type": "basic" }
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "tags": ["Users"],
        "parameters": [
          { "name": "ids", "in": "query", "type": "array", "items": { "type": "integer", "format": "int64" }, "collectionFormat": "multi" }
        ],
        "responses": {
          "200": { "description": "ok", "schema": { "type": "array", "items": { "$ref": "#/definitions/User" } } }
        }
      },
      "post": {
        "operationId": "createUser",
        "tags": ["Users"],
        "security": [{ "basicAuth": [] }],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/NewUser" } }
        ],
        "responses": {
          "201": { "description": "created", "schema": { "$ref": "#/definitions/User" } },
          "400": { "$ref": "#/responses/BadRequest" }
        }
      }
    },
    "/avatar": {
      "post": {
        "operationId": "uploadAvatar",
        "tags": ["Users"],
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "file", "in": "formData", "type": "file", "required": true },
          { "name": "note", "in": "formData", "type": "string" }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "responses": {
    "BadRequest": { "description": "bad", "schema": { "$ref": "#/definitions/Problem" } }
  },
  "definitions": {
    "User": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "manager": { "$ref": "#/definitions/User" },
        "role": { "type": "string", "enum": ["admin", "member"] }
      }
    },
    "NewUser": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "nickname": { "type": "string", "x-nullable": true }
      }
    },
    "Problem": {
      "type": "object",
      "properties": { "code": { "type": "integer", "format": "int32" }, "message": { "type": "string" } }
    }
  }
}
