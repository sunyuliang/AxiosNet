{
  "openapi": "3.0.3",
  "info": { "title": "Adversarial", "version": "0.0.1" },
  "paths": {
    "/broken": {
      "get": {
        "operationId": "brokenRef",
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Missing" } } } }
        }
      }
    },
    "/multi-type": {
      "get": {
        "operationId": "multiType",
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "type": ["string", "integer"] } } } }
        }
      }
    },
    "/tuple": {
      "get": {
        "operationId": "tuple",
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "integer" }] } } } }
        }
      }
    },
    "/union": {
      "get": {
        "operationId": "union",
        "parameters": [
          { "name": "cookie", "in": "cookie", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Union" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Union": {
        "anyOf": [
          { "$ref": "#/components/schemas/Left" },
          { "$ref": "#/components/schemas/Right" }
        ]
      },
      "Left": {
        "type": "object",
        "properties": { "left": { "type": "string" } }
      },
      "Right": {
        "type": "object",
        "properties": { "right": { "type": "integer", "format": "int32" } }
      }
    }
  }
}
