{
  "openapi": "3.0.3",
  "info": {
    "title": "AxiosNet Sample API",
    "version": "1.5.0",
    "description": "示例文档：对应 DemoApiServer 的路由，用于演示 axiosnet-gen 生成声明式客户端。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "users",
      "description": "用户管理"
    },
    {
      "name": "auth",
      "description": "登录与受保护资源"
    },
    {
      "name": "files",
      "description": "文件上传"
    },
    {
      "name": "streams",
      "description": "流式响应"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "listUsers",
        "summary": "列出用户，可按 role 与 ids 过滤",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "description": "角色过滤（admin / dev）",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "description": "用户 Id 过滤，explode=true → ids=1&ids=2",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "operationId": "createUser",
        "summary": "创建用户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "getUser",
        "summary": "按 Id 查询用户",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "users"
        ],
        "operationId": "deleteUser",
        "summary": "删除用户",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "summary": "JSON 登录",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "令牌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login/form": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "loginForm",
        "summary": "表单登录（application/x-www-form-urlencoded）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/LoginPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "令牌与用户名",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginFormResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/secure/profile": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getProfile",
        "summary": "受保护资源：需要 Bearer 令牌",
        "parameters": [
          {
            "name": "X-Device",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前会话信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecureProfile"
                }
              }
            }
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "tags": [
          "files"
        ],
        "operationId": "upload",
        "summary": "multipart 上传：文本字段 + 文件",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "Title"
                ],
                "properties": {
                  "Title": {
                    "type": "string",
                    "description": "上传标题"
                  },
                  "File": {
                    "type": "string",
                    "format": "binary",
                    "description": "文件内容"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/stream/events": {
      "get": {
        "tags": [
          "streams"
        ],
        "operationId": "streamEvents",
        "summary": "SSE 流式响应",
        "responses": {
          "200": {
            "description": "事件流",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamItem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/stream/pages": {
      "get": {
        "tags": [
          "streams"
        ],
        "operationId": "streamPages",
        "summary": "JSON 数组流式响应",
        "responses": {
          "200": {
            "description": "分页流",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "x-axios-stream": "array",
                  "items": {
                    "$ref": "#/components/schemas/StreamItem"
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "age",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "dev"
            ]
          }
        }
      },
      "NewUser": {
        "type": "object",
        "required": [
          "name",
          "age"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreatedUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "age",
          "role",
          "trace"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "role": {
            "type": "string"
          },
          "trace": {
            "type": "string",
            "description": "服务器回显的 X-Trace 请求头"
          }
        }
      },
      "DeleteResult": {
        "type": "object",
        "required": [
          "id",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "LoginPayload": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "TokenResult": {
        "type": "object",
        "required": [
          "token",
          "expiresIn"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginFormResult": {
        "type": "object",
        "required": [
          "token",
          "expiresIn",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32"
          },
          "user": {
            "type": "string"
          }
        }
      },
      "SecureProfile": {
        "type": "object",
        "required": [
          "user",
          "issuedBy",
          "device"
        ],
        "properties": {
          "user": {
            "type": "string"
          },
          "issuedBy": {
            "type": "string"
          },
          "device": {
            "type": "string"
          }
        }
      },
      "UploadResult": {
        "type": "object",
        "required": [
          "partCount",
          "title",
          "parts"
        ],
        "properties": {
          "partCount": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPart"
            }
          }
        }
      },
      "UploadedPart": {
        "type": "object",
        "required": [
          "name",
          "length"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "fileName": {
            "type": "string",
            "nullable": true
          },
          "contentType": {
            "type": "string",
            "nullable": true
          },
          "length": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "StreamItem": {
        "type": "object",
        "required": [
          "index",
          "text"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
