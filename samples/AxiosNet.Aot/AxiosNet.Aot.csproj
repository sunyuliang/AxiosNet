<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AxiosNet.Aot</RootNamespace>
    <AssemblyName>AxiosNet.Aot</AssemblyName>

    <!-- Native AOT 发布：dotnet publish -c Release -r win-x64（或 linux-x64） -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AxiosNet\AxiosNet.csproj" />
    <!-- 源生成器（随 NuGet 包自动分发的分析器）：编译期为请求模型烘焙元数据，AOT 下不再依赖 TrimmerRootAssembly。 -->
    <ProjectReference Include="..\..\src\AxiosNet.SourceGen\AxiosNet.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
