<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与 AxiosNet 相同：单目标 net6.0，.NET 6 / 7 / 8 / 9 / 10 / 11 一份资产通吃，代码不用 6.0 之后的 BCL API -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ===== NuGet 包元数据 ===== -->
  <PropertyGroup>
    <PackageId>AxiosNet.WebAPI</PackageId>
    <Title>AxiosNet.WebAPI - 声明式 API 客户端（基于 AxiosNet）</Title>
    <!-- 本地默认版本；CI 发布时由 tag 覆盖（-p:Version=x.y.z），与 AxiosNet 同 tag 同版本 -->
    <Version>1.0.0</Version>
    <Authors>sunyuliang</Authors>
    <Copyright>Copyright (c) 2026 sunyuliang</Copyright>
    <Description>基于 AxiosNet 的声明式 API 客户端：只定义请求模型（标注 HTTP 方法与路径模板）和返回模型、配好授权，即可 client.RequestAsync(request) 访问任意 API——返回类型由请求模型自动确定（IApiRequest&lt;TResponse&gt;），无需在调用处再写一遍泛型。对标 Refit 的声明式体验，但保留 axios 风格的完整响应（data/status/headers/config/request）。DI 单例注入扩展见配套包 AxiosNet.DependencyInjection。A declarative API client built on AxiosNet: define request models with route attributes, plug in an authorization provider, and call client.RequestAsync(request) — the response type is inferred from the request model. For singleton DI registration see the companion package AxiosNet.DependencyInjection.</Description>
    <PackageTags>axios;http;httpclient;rest;api-client;declarative;refit;restsharp;flurl;typed-client;csharp;dotnet;net6;net7;net8;net9;net10;net11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/sunyuliang/AxiosNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sunyuliang/AxiosNet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- ===== 符号包 + XML 文档 ===== -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- 打进包的 README（本包自己的说明）/ LICENSE（仓库根目录） -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxiosNet\AxiosNet.csproj" />
  </ItemGroup>

  <!-- SourceLink：与 AxiosNet 相同，仅在 GitHub Actions 里启用 -->
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
