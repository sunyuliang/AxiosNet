<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 双目标：net6.0 是运行基线（.NET 6 / 7 消费方取 lib/net6.0），net8.0 是分析基线（.NET 8+ 取 lib/net8.0）。
         源码同一份，只有一处 #if NET8_0_OR_GREATER：枚举取值改用按底层类型返回的重载（AOT 安全）。
         运行时行为不随 TFM 变化——两者都绑定到消费方运行时自带的 BCL；
         多出 net8.0 目标的实际收益是 net7+ 才可用的分析器：AOT 分析器在 net6.0 目标上被 SDK 直接拒绝（NETSDK1210）。
         不使用 netstandard：连接池依赖 SocketsHttpHandler，netstandard2.0 里没有该类型。 -->
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <!-- net6.0 默认 C# 10，显式用最新语言版本（测试项目同样如此） -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 声明本程序集可被裁剪（消费方 PublishTrimmed / PublishAot 时按需裁剪），
         同时启用裁剪分析器：反射入口的 DynamicallyAccessedMembers 标注与抑制理由必须始终自洽。 -->
    <IsTrimmable>true</IsTrimmable>
    <!-- AOT 分析器（IL3050）只在 net7.0+ 目标上可用：net6.0 目标被 SDK 判为「不支持」并给 NETSDK1210。 -->
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- ===== NuGet 包元数据 ===== -->
  <PropertyGroup>
    <PackageId>AxiosNet</PackageId>
    <Title>AxiosNet - axios 风格 HTTP 客户端 + 声明式 API 客户端（.NET 6+）</Title>
    <!-- 本地默认版本；CI 发布时由 tag 覆盖（-p:Version=x.y.z） -->
    <Version>1.0.1</Version>
    <Authors>sunyuliang</Authors>
    <Copyright>Copyright (c) 2026 sunyuliang</Copyright>
    <Description>用 .NET 实现的 axios 风格 HTTP 客户端：API 与 JS axios 一一对应，内置按 origin 隔离的连接池（连接复用、并发上限、空闲驱逐、可观测统计），零第三方运行时依赖。同一包内置声明式 API 客户端（AxiosNet.WebAPI 命名空间，对标 Refit）：定义请求模型（路由/参数特性）+ 授权，调用只剩一句 client.RequestAsync(request)，返回类型由请求模型自动确定，底层仍是完整管线。DI 单例注入扩展见配套包 AxiosNet.DependencyInjection。支持 .NET 6 及以上全部运行时（6/7/8/9/10/11）：net6.0 / net8.0 双目标，.NET 8+ 自动取 net8.0 资产、旧运行时取 net6.0 资产，无需配置。An axios-style HTTP client for .NET — dual-targeted net6.0 / net8.0, runs on .NET 6/7/8/9/10/11. The same package also includes a declarative API client (namespace AxiosNet.WebAPI, Refit-style): request models with route/parameter attributes + authorization, one call client.RequestAsync(request). For singleton DI registration see the companion package AxiosNet.DependencyInjection.</Description>
    <PackageTags>axios;http;httpclient;http-client;rest;json;api-client;declarative;refit;restsharp;flurl;typed-client;connection-pool;csharp;dotnet;net6;net7;net8;net9;net10;net11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/sunyuliang/AxiosNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sunyuliang/AxiosNet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- ===== 符号包 + XML 文档 ===== -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- 测试需要确定性地复现熔断淘汰的「快照后状态被并发推进」竞态（CircuitBreaker 的内部测试钩子）。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="AxiosNet.Tests" />
  </ItemGroup>

  <!-- 把仓库根目录的 README / LICENSE 打进包 -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- SourceLink：snupkg 可反查 GitHub 源码；PrivateAssets=all，不会成为包的依赖。
       仅在 GitHub Actions（镜像仓库）里启用：主仓是 Gitee，本地构建拿不到 GitHub 的 origin 映射，
       启用只会产生「源链接为空」的告警。 -->
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
