<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 三目标：net6.0 是 .NET 6 / 7 消费方资产，net8.0 是 .NET 8+ 消费方资产（同时启用 AOT 分析器），
         netstandard2.0 是兼容资产（.NET Framework 4.7.2+ / .NET Core 2.0+ / .NET 5+ 中无法取到前两者时兜底）。
         NuGet 按兼容性自动选资产：.NET 6+ 永远取 net6.0 / net8.0，不会落到兼容资产上，因此主路径行为不变。
         源码同一份，条件编译分两类：
         (1) NET7_0_OR_GREATER / NET8_0_OR_GREATER 共 9 处，只包 net7+ 专属 API 与 AOT 标注；
         (2) NETSTANDARD2_0 分支，只包「netstandard2.0 契约里根本不存在的类型 / 虚方法 / 语言特性」：
             SocketsHttpHandler 家族配置、HttpVersionPolicy、默认接口实现、带令牌的 HttpContent 与 Stream override、
             方法级 AsyncMethodBuilder。兼容资产是功能子集，降级清单见 README「.NET Standard 2.0 兼容资产」。
         netstandard2.0 目标额外引用 9 个微软第一方 BCL 兼容包（见下方条件 ItemGroup），这些依赖只进兼容资产。 -->
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <!-- net6.0 默认 C# 10，显式用最新语言版本（测试项目同样如此） -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 声明本程序集可被裁剪（消费方 PublishTrimmed / PublishAot 时按需裁剪），
         同时启用裁剪分析器：反射入口的 DynamicallyAccessedMembers 标注与抑制理由必须始终自洽。 -->
    <!-- 裁剪分析需要 net6+ 的 BCL 标注：netstandard2.0 目标上开它会与兼容包里的 internal 标注冲突。 -->
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsTrimmable>
    <!-- AOT 分析器（IL3050）只在 net7.0+ 目标上可用：net6.0 目标被 SDK 判为「不支持」并给 NETSDK1210。 -->
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <!-- 「WebAPI 可整体删除」的实证开关：为 true 时把 WebAPI/ 下的源码与嵌入资源排除出编译，
         只留内核。eng/build-without-webapi.ps1 用它做独立构建校验（必须 0 error）。 -->
    <AxiosNetOmitWebApi Condition="'$(AxiosNetOmitWebApi)' == ''">false</AxiosNetOmitWebApi>
  </PropertyGroup>

  <!-- ===== NuGet 包元数据 ===== -->
  <PropertyGroup>
    <PackageId>AxiosNet</PackageId>
    <Title>AxiosNet - axios 风格 HTTP 客户端 + 声明式 API 客户端（.NET 6+ / .NET Framework 4.7.2+）</Title>
    <!-- 本地默认版本；CI 发布时由 tag 覆盖（-p:Version=x.y.z） -->
    <Version>1.6.0</Version>
    <Authors>sunyuliang</Authors>
    <Copyright>Copyright (c) 2026 sunyuliang</Copyright>
    <Description>用 .NET 实现的 axios 风格 HTTP 客户端：API 与 JS axios 一一对应，内置按 origin 隔离的连接池（连接复用、并发上限、空闲驱逐、可观测统计）。同一包内置声明式 API 客户端（AxiosNet.WebAPI 命名空间，对标 Refit）：定义请求模型（路由/参数特性）+ 授权，调用只剩一句 client.RequestAsync(request)，返回类型由请求模型自动确定，底层仍是完整管线。DI 单例注入扩展见配套包 AxiosNet.DependencyInjection。三目标：net6.0 / net8.0 覆盖 .NET 6 及以上全部运行时（6/7/8/9/10/11，零第三方运行时依赖），netstandard2.0 兼容资产覆盖 .NET Framework 4.7.2+ 与 .NET Core 2.0+（依赖 9 个微软第一方 BCL 兼容包，功能子集见 README）。An axios-style HTTP client for .NET — tri-targeted netstandard2.0 / net6.0 / net8.0, runs on .NET 6/7/8/9/10/11 and .NET Framework 4.7.2+ / .NET Core 2.0+. The same package also includes a declarative API client (namespace AxiosNet.WebAPI, Refit-style): request models with route/parameter attributes + authorization, one call client.RequestAsync(request). For singleton DI registration see the companion package AxiosNet.DependencyInjection.</Description>
    <PackageTags>axios;http;httpclient;http-client;rest;json;api-client;declarative;refit;restsharp;flurl;typed-client;connection-pool;csharp;dotnet;netstandard;netframework;net6;net7;net8;net9;net10;net11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/sunyuliang/AxiosNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sunyuliang/AxiosNet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- ===== 符号包 + XML 文档 ===== -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- netstandard2.0 的引用程序集缺少 [NotNullWhen(false)] 一类 nullable 注解：
       string.IsNullOrWhiteSpace / IsNullOrEmpty 在 net6.0 / net8.0 上判空后能把变量收窄为非空，
       在兼容资产上却仍是 string?，于是「判空后 Trim()」「new[] { value }」等写法会报
       CS8602 / CS8603 / CS8604 / CS8620。经逐条核对，全部是同一份源码在注解齐全的两个目标上零警告的假阳性。
       只在这一个目标上屏蔽这四个码；net6.0 / net8.0 的完整 nullable 检查保持不变，新增代码不会漏检。 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <NoWarn>$(NoWarn);CS8602;CS8603;CS8604;CS8620</NoWarn>
  </PropertyGroup>

  <!-- ===== netstandard2.0 兼容资产：微软第一方 BCL 兼容包 =====
       这些 API 在 net6.0 / net8.0 目标里由运行时自带，只有兼容资产需要显式引用；
       PrivateAssets 不设，依赖需要随兼容资产流到消费方（否则 Framework / .NET Core 2.x 加载不到）。
       全部是 Microsoft 出品的 BCL 补位包，不含任何第三方实现。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <PackageReference Include="System.Reflection.DispatchProxy" Version="4.7.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <!-- 测试需要确定性地复现熔断淘汰的「快照后状态被并发推进」竞态（CircuitBreaker 的内部测试钩子）。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="AxiosNet.Tests" />
    <InternalsVisibleTo Include="AxiosNet.Compat.Tests" />
  </ItemGroup>

  <!-- WebAPI 目录是可整体删除的扩展：开关打开后连嵌入资源一起排除，内核不得依赖它们。 -->
  <ItemGroup Condition="'$(AxiosNetOmitWebApi)' == 'true'">
    <Compile Remove="WebAPI/**/*.cs" />
    <EmbeddedResource Remove="WebAPI/**/*" />
    <None Remove="WebAPI/**/*" />
  </ItemGroup>

  <!-- 编译期禁止：内核目录不得引用 WebAPI 类型。
       BannedSymbols.txt 由 eng/generate-banned-symbols.ps1 从 WebAPI 的公共类型清单生成（逐类型一条）；
       规则只在 src/AxiosNet/ 生效为 error，WebAPI 目录内由子目录 .editorconfig 关闭。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- 把仓库根目录的 README / LICENSE 打进包 -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- ===== 源生成器（编译期资产，不进运行时依赖） ===== -->
  <ItemGroup>
    <!-- 只用于构建顺序：分析器 DLL 由下面的打包目标收集，不参与本程序集编译。 -->
    <ProjectReference Include="..\AxiosNet.SourceGen\AxiosNet.SourceGen.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="buildTransitive\AxiosNet.props" Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>

  <!-- dotnet pack 会在构建之后执行本目标：把生成器 DLL 放进 analyzers/dotnet/cs，
       消费方只引用 AxiosNet 就能自动生成元数据。 -->
  <Target Name="_AxiosNetIncludeSourceGenerator" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\AxiosNet.SourceGen\bin\$(Configuration)\netstandard2.0\AxiosNet.SourceGen.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!-- SourceLink：snupkg 可反查 GitHub 源码；PrivateAssets=all，不会成为包的依赖。
       仅在 GitHub Actions（镜像仓库）里启用：主仓是 Gitee，本地构建拿不到 GitHub 的 origin 映射，
       启用只会产生「源链接为空」的告警。 -->
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
