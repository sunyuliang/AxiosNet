<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 单目标 net6.0：.NET 向高版本兼容，同一份程序集可直接跑在 .NET 6 / 7 / 8 / 9 / 10 / 11 上，
         无需为每个运行时重复发布资产。代码也不使用任何 6.0 之后才有的 BCL API。
         不使用 netstandard：连接池依赖 SocketsHttpHandler，netstandard2.0 里没有该类型。 -->
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 默认 C# 10，显式用最新语言版本（测试项目同样如此） -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ===== NuGet 包元数据 ===== -->
  <PropertyGroup>
    <PackageId>AxiosNet</PackageId>
    <Title>AxiosNet</Title>
    <!-- 本地默认版本；CI 发布时由 tag 覆盖（-p:Version=x.y.z） -->
    <Version>1.0.0</Version>
    <Authors>sunyuliang</Authors>
    <Copyright>Copyright (c) 2026 sunyuliang</Copyright>
    <Description>用 .NET 实现的 axios 风格 HTTP 客户端：API 与 JS axios 一一对应，内置按 origin 隔离的连接池（连接复用、并发上限、空闲驱逐、可观测统计），零第三方运行时依赖。单目标 net6.0，适用于 .NET 6 及以上的全部运行时（6/7/8/9/10/11…）。An axios-style HTTP client for .NET.</Description>
    <PackageTags>axios;http;httpclient;rest;json;api-client;connection-pool;net6;net8;net9;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/sunyuliang/AxiosNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sunyuliang/AxiosNet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- ===== 符号包 + XML 文档 ===== -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- 把仓库根目录的 README / LICENSE 打进包 -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- SourceLink：snupkg 可反查 GitHub 源码；PrivateAssets=all，不会成为包的依赖。
       仅在 GitHub Actions（镜像仓库）里启用：主仓是 Gitee，本地构建拿不到 GitHub 的 origin 映射，
       启用只会产生「源链接为空」的告警。 -->
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
